# Installed by `make service`. Paths are filled in from the clone location.
[Unit]
Description=llm-trader deterministic paper loop
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__APP_DIR__
# '-' means start anyway if the file is missing, so `make env` is not a hard prerequisite
EnvironmentFile=-__APP_DIR__/.env
ExecStart=__APP_DIR__/.venv/bin/python -u scripts/live.py \
    --strategy deterministic --broker alpaca --notional-pct 100
Restart=always
RestartSec=30
# exit 2 means "another process owns this account". Restarting would just loop; stop instead.
RestartPreventExitStatus=2
# No StandardOutput redirect: Python's output goes to journald, so `make service-logs` shows the
# actual decisions. Redirecting it to a file made journalctl look empty, which is how you end up
# flying blind for a week.

[Install]
WantedBy=multi-user.target
